# ---------------------------------------------------------------------------
# Asdra Fit — variáveis de ambiente de exemplo.
# Copie para apps/api/.env e apps/mobile/.env e ajuste. NUNCA versione segredos reais.
# ---------------------------------------------------------------------------

# ============================ Backend (apps/api) ============================
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://adsidera:adsidera@localhost:5433/adsidera?schema=public

# Gere segredos fortes (ex.: `openssl rand -hex 32`). NÃO use estes em produção.
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_fedcba9876543210
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=info

# Rate limiting (janela em segundos e nº máximo de requisições por janela).
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Proteção de brute-force no login.
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_TTL=900

# ============================ Mobile (apps/mobile) ============================
# Padrão: API hospedada no Railway. Use http://<IP-da-máquina>:3000/api/v1 só se
# for testar contra a API rodando local (pnpm dev:api).
EXPO_PUBLIC_API_URL=https://ad-sideraapi-production.up.railway.app/api/v1
EXPO_PUBLIC_ENVIRONMENT=development
EXPO_PUBLIC_ENABLE_DEV_MENU=true
# Libera login, cadastro, recuperação de senha e a aba de liga (todas redirecionam
# para fora quando false). Ligado desde que a API subiu no Railway.
EXPO_PUBLIC_ENABLE_ONLINE_FEATURES=true

# Banner AdMob (MRK-C). Fora de um build EAS a SDK nativa não existe, então no
# Expo Go isto só troca o slot por um marcador de desenvolvimento.
EXPO_PUBLIC_ENABLE_ADS=false
# Unit IDs reais pertencem APENAS ao perfil `production` do apps/mobile/eas.json.
# Ausentes ou malformados, o app cai no ID de teste do Google — de propósito:
# clique de testador em anúncio real é tráfego inválido e suspende a conta AdMob.
# EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
# EXPO_PUBLIC_ADMOB_BANNER_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
