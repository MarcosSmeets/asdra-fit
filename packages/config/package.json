{
  "name": "@ad-sidera/config",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "react-native": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "echo \"no tests for config\" && exit 0"
  },
  "devDependencies": {
    "@ad-sidera/eslint-config": "workspace:*",
    "@ad-sidera/typescript-config": "workspace:*",
    "eslint": "^8.57.0",
    "typescript": "^5.7.2"
  }
}
