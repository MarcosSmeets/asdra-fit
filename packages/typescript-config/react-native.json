{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Ad Sidera React Native (Expo)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM"],
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true
  }
}
